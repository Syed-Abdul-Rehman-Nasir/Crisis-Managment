# Replace these placeholders with your actual API keys
# DO NOT commit the actual .env file to version control

# Weather data is fetched using wttr.in, which is free and requires NO API KEY.
# WEATHER_API_KEY is no longer needed.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override if your key does not support the default model
GEMINI_MODEL=gemini-2.0-flash
# Default false — app uses template fallbacks (no quota needed). Set true when Gemini key has quota.
USE_GEMINI=false
